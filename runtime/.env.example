# Zhentan runtime — pull-only worker configuration.
# NOTE the absences: no SUPABASE_*, no SPONSOR key. The runtime speaks only
# the backend Runtime API; a database credential must NEVER appear in this
# file (managed or self-hosted). Since D4 it holds the ONE threshold-bearing
# key in the system: AGENT_PRIVATE_KEY lives here and nowhere else.

# Backend Runtime API base URL (the Express server).
RUNTIME_API_URL=http://localhost:3001

# Bearer token — must match the backend's RUNTIME_API_TOKEN.
RUNTIME_API_TOKEN=

# Agent identity presented on leases/results. Every Safe maps to
# "shared-agent" until P7/F1 introduce unique identities.
AGENT_INSTANCE_ID=shared-agent

# Job long-poll interval in ms.
POLL_INTERVAL_MS=3000

# Localhost-only health listener port.
HEALTH_PORT=3002

# Local decision store (append-only JSONL). Default: ./data/decisions.jsonl
# DECISION_STORE_PATH=

# ── D4: signing (the runtime holds the ONLY threshold-bearing key) ──
# The agent owner key. Post-D4 this belongs to the runtime env ONLY —
# it must NEVER appear in server/.env again.
AGENT_PRIVATE_KEY=

# RPC for chain reads (owners/threshold/nonce verification before signing).
RUNTIME_RPC_URL=https://1rpc.io/bnb
