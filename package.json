{
  "name": "zhentan",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev:client": "pnpm --filter zhentan-client dev",
    "dev:server": "pnpm --filter zhentan-server dev",
    "dev:runtime": "pnpm --filter zhentan-runtime dev",
    "dev:docs": "cd docs && mintlify dev --port 3002",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "mintlify": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@reown/appkit",
      "bufferutil",
      "core-js",
      "esbuild",
      "keccak",
      "supabase",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
