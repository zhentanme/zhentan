# Zhentan MCP server — the only bridge between the agent skill and the backend.

# REQUIRED. Backend base URL. There is deliberately NO default: silently
# falling back to production would let a misconfigured local or staging
# agent operate on real users' Safes. Set http://localhost:3001 for local dev.
ZHENTAN_API_URL=

# REQUIRED. Shared secret for agent → server authentication.
# Must match AGENT_SECRET in server/.env.
AGENT_SECRET=

# Transport: "stdio" (default). Streamable HTTP is a planned follow-up.
MCP_TRANSPORT=stdio
