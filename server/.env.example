# Supabase — project URL and service-role key (bypasses RLS, server-side only)
# Get both from: https://supabase.com/dashboard → project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Schema is managed with the Supabase CLI (see server/supabase/README.md).
# Migrations use `supabase link` + `supabase db push`, not a connection string here.

# Agent signer private key (for POST /execute co-signing)
# Generate a private key for your agent and use the signer address on client .env
AGENT_PRIVATE_KEY=

# Gas sponsor private key — the EOA that sends transactions and pays BNB gas
# (Safe deploys, execTransaction relaying, rejections). Optional: defaults to
# AGENT_PRIVATE_KEY. May be a distinct key; the agent key then never pays gas
# and never appears as a transaction sender.
SPONSOR_PRIVATE_KEY=

# Treasury Safe — server-controlled 3-owner / threshold-1 Safe used for payouts
# TREASURY_PRIVATE_KEY: server signer (generates the Safe's autonomous signer)
# TREASURY_SIGNER_1/2: external signer addresses (owners for manual recovery; no private key needed)
# TREASURY_TOKEN_ADDRESS: default ERC-20 to send (e.g. USDC on BSC)
# TREASURY_TOKEN_DECIMALS: decimals for the default token (default: 18)
TREASURY_PRIVATE_KEY=
TREASURY_SIGNER_1=
TREASURY_SIGNER_2=
TREASURY_TOKEN_ADDRESS=
TREASURY_TOKEN_DECIMALS=18

# Get your Pimlico bundler and paymaster API key from https://dashboard.pimlico.io
# Only used for executing legacy pre-refactor 4337 queue rows and treasury payouts —
# all user transactions are standard SafeTx now.
PIMLICO_API_KEY=

# Safe Transaction Service (SafeTx flow — Safe{Wallet} UI compatibility).
# SAFE_API_KEY: get one at https://developer.safe.global
# SAFE_TX_SERVICE_URL: optional override; defaults to the hosted BSC service.
SAFE_API_KEY=
SAFE_TX_SERVICE_URL=

# Safe address derivation for NEW accounts (existing accounts always use the
# version stored on their record): 2 = vanilla stock Safe (default),
# 1 = legacy 4337-module initializer.
SAFE_DERIVATION_VERSION=2

# Agent relayer gas watchdog: alert (Telegram admin) when the agent EOA's BNB
# balance drops below this threshold. The agent pays gas for Safe deployments
# and execTransaction relaying in the SafeTx flow.
AGENT_MIN_BNB=0.05

# Zerion API key (for portfolio / token balances on BNB Chain). Get one at https://zerion.io
ZERION_API_KEY=

# Telegram bot token (for REVIEW/BLOCK notifications)
TELEGRAM_BOT_TOKEN=

# Resend — for transactional email notifications (onboarding, etc.)
# RESEND_API_KEY: from https://resend.com/api-keys
# RESEND_FROM_EMAIL: verified sender, e.g. "Zhentan <hello@zhentan.me>"
# RESEND_ONBOARDING_TEMPLATE_ID: dashboard template id for the welcome email
#   (https://resend.com/docs/dashboard/templates/introduction)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ONBOARDING_TEMPLATE_ID=

# RPC endpoints for name resolution (optional — public fallbacks used if not set)
# ETH mainnet: used for .eth (ENS) resolution
ETH_RPC_URL=
# BNB mainnet: used for .bnb (SPACE ID) resolution
BSC_RPC_URL=

# Admin API key — required for /payout endpoints (treasury management).
# Generate with: openssl rand -hex 32
# Pass as x-admin-key header.
ADMIN_API_KEY=

# REQUIRED. Shared secret for agent → server authentication.
# Generate with: openssl rand -hex 32
# Must match AGENT_SECRET in your NanoBot/Hermes skill environment variables.
# The server refuses to start without it — an unset secret used to disable
# authentication on every protected route, so it now fails closed instead.
# For local work without an agent, set DEV_OPEN=1 (see below) rather than
# leaving this blank.
AGENT_SECRET=

# Local development escape hatch: DEV_OPEN=1 disables authentication entirely so
# the server runs with no secrets configured. Ignored — and refused at boot —
# when NODE_ENV=production. Never set this on a deployed server.
DEV_OPEN=

# Privy — for verifying client identity tokens.
# PRIVY_APP_ID: same value as NEXT_PUBLIC_PRIVY_APP_ID in the client.
# PRIVY_JWT_VERIFICATION_KEY: from Privy Dashboard → App Settings → Basics → JWT Verification Key (copy the full JSON).
PRIVY_APP_ID=
PRIVY_JWT_VERIFICATION_KEY=

# Server port
PORT=3001

# CORS origin (optional; defaults to allow all)
CORS_ORIGIN=

# Runtime API (D1) — bearer token for the runtime worker. Unset = the
# /runtime endpoints answer 503 (fail closed). Must match runtime/.env.
RUNTIME_API_TOKEN=

# ── D4: agent identity (the KEY lives in runtime/.env, never here) ──
# The agent owner EOA address. Required in production; sign-job results
# are verified against it (signedBy + recovered signature).
AGENT_ADDRESS=
